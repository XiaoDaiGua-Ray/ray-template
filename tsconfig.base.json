{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "newLine": "LF",
    "noEmit": true,
    "incremental": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@": ["./apps/admin/src"],
      "@/*": ["./apps/admin/src/*"],
      "@api": ["./apps/admin/src/api"],
      "@api/*": ["./apps/admin/src/api/*"],
      "@images": ["./apps/admin/src/assets/images"],
      "@images/*": ["./apps/admin/src/assets/images/*"],
      "@mock": ["./apps/admin/src/mocks"],
      "@mock/*": ["./apps/admin/src/mocks/*"]
    }
  }
}
