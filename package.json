{
  "name": "ray-template",
  "private": true,
  "version": "6.0.1",
  "type": "module",
  "engines": {
    "node": "^26.13.0",
    "pnpm": "12.16.1"
  },
  "scripts": {
    "dev": "pnpm icons:generate && vite",
    "icons:generate": "node scripts/icons.mjs",
    "icons:check": "node scripts/icons.mjs --check",
    "typecheck": "pnpm icons:check && vue-tsc --build && tsc -p tsconfig.universal.json",
    "build": "pnpm icons:generate && pnpm typecheck && vite build",
    "preview": "vite preview",
    "docs:dev": "pnpm --filter @ray-template/docs dev",
    "docs:build": "pnpm --filter @ray-template/docs build",
    "docs:preview": "pnpm --filter @ray-template/docs preview",
    "docs:check": "vue-tsc --noEmit -p apps/docs/tsconfig.json && pnpm docs:build",
    "dev-build": "pnpm icons:generate && pnpm typecheck && vite build --mode development",
    "report": "pnpm icons:generate && vite build --mode report",
    "prepare": "husky",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "harness": "node harness/run.mjs",
    "check": "pnpm check:frontend && pnpm server:check && pnpm dist:check",
    "env:check": "node scripts/doctor.mjs",
    "packages:check": "node scripts/check-package-boundaries.mjs",
    "pages:build": "pnpm build && pnpm docs:build && node scripts/assemble-pages.mjs",
    "api:generate": "node scripts/admin-api.mjs",
    "api:check": "node scripts/admin-api.mjs --check",
    "check:frontend": "pnpm env:check && pnpm harness check && pnpm api:check && pnpm packages:check && pnpm icons:generate && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:run && vite build && pnpm docs:check",
    "dist:frontend": "node scripts/distributions.mjs frontend",
    "dist:fullstack": "node scripts/distributions.mjs fullstack",
    "dist:check": "node scripts/distributions.mjs --check",
    "dev:full": "node scripts/fullstack.mjs dev",
    "fullstack:stop": "node scripts/fullstack.mjs stop",
    "fullstack:up": "node scripts/fullstack.mjs up",
    "server:dev": "pnpm --filter @ray-template/server dev",
    "server:build": "pnpm --filter @ray-template/server build",
    "server:start": "pnpm --filter @ray-template/server start",
    "server:check": "pnpm --filter @ray-template/server check",
    "server:test": "pnpm --filter @ray-template/server test",
    "server:test:integration": "pnpm --filter @ray-template/server test:integration",
    "server:db:migrate": "pnpm --filter @ray-template/server db:migrate",
    "server:db:seed": "pnpm --filter @ray-template/server db:seed",
    "server:credential:set": "pnpm --filter @ray-template/server credential:set",
    "fullstack:setup": "node scripts/fullstack.mjs setup"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,vue}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,css,scss,html,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@faker-js/faker": "10.6.0",
    "@logicflow/core": "2.2.5",
    "@logicflow/extension": "2.3.1",
    "@ray-template/admin-shell": "workspace:*",
    "@ray-template/composables": "workspace:*",
    "@ray-template/directives": "workspace:*",
    "@ray-template/http": "workspace:*",
    "@ray-template/icons": "workspace:*",
    "@ray-template/routing": "workspace:*",
    "@ray-template/ui": "workspace:*",
    "@ray-template/utils": "workspace:*",
    "@valibot/to-json-schema": "1.8.0",
    "@vueuse/core": "15.0.0",
    "axios": "1.21.0",
    "clipboard": "2.0.11",
    "crypto-js": "4.2.0",
    "dayjs": "1.11.23",
    "echarts": "6.1.0",
    "html-to-image": "1.11.13",
    "interactjs": "1.10.28",
    "jsbarcode": "3.12.3",
    "lodash-es": "4.18.1",
    "msw": "3.0.4",
    "naive-ui": "2.45.3",
    "pinia": "4.1.0",
    "pinia-plugin-persistedstate": "4.7.1",
    "print-js": "1.6.0",
    "valibot": "1.5.0",
    "vue": "3.5.45",
    "vue-demi": "0.14.10",
    "vue-hooks-plus": "2.4.3",
    "vue-i18n": "11.4.17",
    "vue-router": "5.4.0",
    "vue3-next-qrcode": "4.1.1",
    "@ray-template/api-contracts": "workspace:*",
    "@ray-template/demo-data": "workspace:*"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@intlify/unplugin-vue-i18n": "11.2.8",
    "@spiriit/vite-plugin-svg-spritemap": "7.2.0",
    "@types/crypto-js": "4.2.2",
    "@types/jsbarcode": "3.11.4",
    "@types/lodash-es": "4.17.12",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "@vitest/ui": "5.1.0",
    "@vue/test-utils": "2.5.1",
    "autoprefixer": "10.6.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "postcss": "8.5.32",
    "postcss-px-to-viewport-8-with-include": "1.2.2",
    "prettier": "3.9.10",
    "rollup-plugin-gzip": "4.2.1",
    "sass": "1.107.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "unocss": "66.12.0",
    "unplugin-auto-import": "21.1.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.3.5",
    "vite-bundle-analyzer": "1.3.9",
    "vite-plugin-cdn2": "1.1.0",
    "vite-plugin-ejs": "2.0.0",
    "vite-plugin-inspect": "12.1.0",
    "vite-svg-loader": "5.1.3",
    "vitest": "5.1.0",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.14",
    "yaml": "2.9.1",
    "esbuild": "0.28.2"
  },
  "description": "Ray Template is an open-source Vue 3 admin dashboard template built with TypeScript (TSX), Vite and Naive UI. Includes role-based routing, responsive layouts and data tables.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiaoDaiGua-Ray/ray-template.git"
  },
  "keywords": [
    "ray-template",
    "admin-dashboard",
    "admin-template",
    "vue3",
    "typescript",
    "tsx",
    "vite",
    "naive-ui",
    "pinia",
    "\u4e2d\u540e\u53f0\u6a21\u677f"
  ],
  "license": "MIT",
  "author": {
    "name": "Ray",
    "url": "https://github.com/XiaoDaiGua-Ray"
  },
  "bugs": {
    "url": "https://github.com/XiaoDaiGua-Ray/ray-template/issues"
  },
  "homepage": "https://xiaodaigua-ray.github.io/ray-template/",
  "packageManager": "pnpm@12.16.1",
  "msw": {
    "workerDirectory": [
      "apps/admin/public"
    ]
  }
}
