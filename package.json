{
  "name": "ray-template",
  "private": false,
  "version": "5.2.5",
  "type": "module",
  "engines": {
    "node": "^26.13.0",
    "pnpm": "12.16.1"
  },
  "scripts": {
    "dev": "pnpm icons:generate && vite",
    "icons:generate": "node scripts/icons.mjs",
    "icons:check": "node scripts/icons.mjs --check",
    "typecheck": "pnpm icons:check && vue-tsc --build",
    "build": "pnpm icons:generate && pnpm typecheck && vite build",
    "preview": "vite preview",
    "dev-build": "pnpm icons:generate && pnpm typecheck && vite build --mode development",
    "report": "pnpm icons:generate && vite build --mode report",
    "prepare": "husky",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm env:check && pnpm icons:generate && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:run && vite build",
    "env:check": "node scripts/doctor.mjs"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,vue}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,css,scss,html,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@faker-js/faker": "10.6.0",
    "@logicflow/core": "2.2.5",
    "@logicflow/extension": "2.3.1",
    "@vueuse/core": "15.0.0",
    "axios": "1.21.0",
    "clipboard": "2.0.11",
    "crypto-js": "4.2.0",
    "currency.js": "2.0.4",
    "dayjs": "1.11.23",
    "echarts": "6.1.0",
    "html-to-image": "1.11.13",
    "interactjs": "1.10.28",
    "jsbarcode": "3.12.3",
    "lodash-es": "4.18.1",
    "naive-ui": "2.45.3",
    "pinia": "4.1.0",
    "pinia-plugin-persistedstate": "4.7.1",
    "print-js": "1.6.0",
    "vue": "3.5.44",
    "vue-demi": "0.14.10",
    "vue-hooks-plus": "2.4.3",
    "vue-i18n": "11.4.17",
    "vue-router": "5.4.0",
    "vue3-next-qrcode": "4.1.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@intlify/unplugin-vue-i18n": "11.2.8",
    "@spiriit/vite-plugin-svg-spritemap": "7.2.0",
    "@types/crypto-js": "4.2.2",
    "@types/jsbarcode": "3.11.4",
    "@types/lodash-es": "4.17.12",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "@vitest/ui": "5.0.5",
    "@vue/test-utils": "2.5.1",
    "autoprefixer": "10.6.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "postcss": "8.5.32",
    "postcss-px-to-viewport-8-with-include": "1.2.2",
    "prettier": "3.9.10",
    "rollup-plugin-gzip": "4.2.1",
    "sass": "1.107.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "unocss": "66.12.0",
    "unplugin-auto-import": "21.1.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.3.5",
    "vite-bundle-analyzer": "1.3.9",
    "vite-plugin-cdn2": "1.1.0",
    "vite-plugin-ejs": "2.0.0",
    "vite-plugin-inspect": "12.1.0",
    "vite-plugin-mock-dev-server": "2.7.1",
    "vite-svg-loader": "5.1.3",
    "vitest": "5.0.5",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.14"
  },
  "description": "Vue 3 + TypeScript + Vite admin template with Naive UI, Pinia and AI-assisted development conventions.",
  "main": "index.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiaoDaiGua-Ray/xiaodaigua-ray.github.io.git"
  },
  "keywords": [
    "ray-template",
    "vue3-tsx-vite-pinia",
    "ray template",
    "vite",
    "vue3",
    "admin template",
    "中后台模板"
  ],
  "license": "MIT",
  "author": {
    "name": "Ray",
    "url": "https://github.com/XiaoDaiGua-Ray"
  },
  "bugs": {
    "url": "https://github.com/XiaoDaiGua-Ray/xiaodaigua-ray.github.io/issues"
  },
  "homepage": "https://github.com/XiaoDaiGua-Ray/xiaodaigua-ray.github.io#readme",
  "packageManager": "pnpm@12.16.1"
}
